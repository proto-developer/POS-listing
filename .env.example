# Square access token (Developer Dashboard > your app > Credentials)
# Leave blank to run in DEMO mode (nothing is posted, simulates success).
SQUARE_ACCESS_TOKEN=

# sandbox | production
SQUARE_ENV=production

# Optional. Defaults to your main location. Used for stock count.
SQUARE_LOCATION_ID=

# Set stock to 1 per row (each manifest row = one unit). true | false
SQUARE_SET_STOCK=true

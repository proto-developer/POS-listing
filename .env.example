# ──────────────────────────────────────────────────────────────────────────────
# Lister — copy this file to .env.local and fill in every field.
# .env.local is git-ignored; never put real credentials in this example file.
# ──────────────────────────────────────────────────────────────────────────────

# ── Square POS ────────────────────────────────────────────────────────────────
# Access token from developer.squareup.com > your application > Credentials.
# Production token = real catalog. Sandbox token = test catalog (set SQUARE_ENV=sandbox).
# The token needs these permissions: ITEMS_READ, ITEMS_WRITE, INVENTORY_WRITE, MERCHANT_PROFILE_READ.
# Required: without it nothing can be posted and the header shows "Square not connected".
SQUARE_ACCESS_TOKEN=

# production | sandbox   (must match the kind of token above)
SQUARE_ENV=production

# Location to list items under and to set stock at. Blank = your main location.
# Find it at developer.squareup.com > your application > Locations, or leave blank.
SQUARE_LOCATION_ID=

# Set stock to 1 for every row posted (each manifest row = one unit). true | false
SQUARE_SET_STOCK=true

# ── Database (upload history) ─────────────────────────────────────────────────
# MongoDB connection string. Required. Only the stats of each upload are stored
# (file name, date, counts, value, skipped rows) — never the spreadsheet itself.
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1:27017
MONGODB_URI=

# Database name inside that cluster. Blank = lister
MONGODB_DB=lister

# ── Sign in ───────────────────────────────────────────────────────────────────
# The one account that can use the app. Required: nobody can sign in until these are set.
LISTER_USER=

# Password as an scrypt hash. Make it with:  npm run hash-password
# (LISTER_PASSWORD=plain-text also works for a quick first setup, but keep the hash.)
LISTER_PASSWORD_HASH=

# Random string of at least 32 characters used to sign the login cookie. Required.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
LISTER_SECRET=
